# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Model provider -----------------------------------------------------
# OpenAI is the first (and currently only) implemented provider. See ADR 007.
YUKTI_MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me

# Investigator does the heavy reasoning; reviewer is deliberately a separate
# config so we can measure whether a different model catches more defects.
YUKTI_INVESTIGATOR_MODEL=gpt-5
YUKTI_REVIEWER_MODEL=gpt-5
YUKTI_MODEL_TIMEOUT_SECONDS=120
YUKTI_MODEL_MAX_RETRIES=3

# --- Database -----------------------------------------------------------
# Matches docker-compose.yml. Host port 5433 avoids colliding with a local
# Postgres on the default 5432.
DATABASE_URL=sqlite:///./yukti.db

# --- Sandbox / execution ------------------------------------------------
# local  = isolated workspace clone, subprocess with shell=False (MVP default)
# docker = container per run, added in Phase 5. See ADR 004.
YUKTI_SANDBOX_MODE=local
# Parent dir for disposable per-run repository clones.
YUKTI_WORKSPACE_ROOT=./workspaces
YUKTI_COMMAND_TIMEOUT_SECONDS=120
YUKTI_MAX_OUTPUT_BYTES=262144

# --- Agent loop budgets (hard stops, see docs/architecture/security-boundaries.md) ---
YUKTI_MAX_STEPS=40
YUKTI_MAX_TOOL_CALLS=60
YUKTI_MAX_REVISIONS=3
YUKTI_MAX_TOKENS=400000
YUKTI_MAX_WALLCLOCK_SECONDS=900

# --- API / web ----------------------------------------------------------
YUKTI_API_HOST=127.0.0.1
YUKTI_API_PORT=8010
# Comma-separated exact origins. Never use "*" — the API will reject it.
YUKTI_CORS_ORIGINS=http://localhost:5173

# --- Observability (optional) -------------------------------------------
# Yukti persists its own traces to Postgres and does not require these.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
